# ─── SENTINEL ENVIRONMENT CONFIG ─────────────────────────────────────────────
# Copy this to .env and fill in your values

# Groq API Key (required for API/Hybrid/Both modes)
GROQ_API_KEY=gsk_your_key_here

# Flask settings
FLASK_DEBUG=false
PORT=5000

# Path to MediaPipe pose model (required for local/hybrid mode)
# Download from: https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_heavy/float16/latest/pose_landmarker_heavy.task
MEDIAPIPE_MODEL_PATH=pose_landmarker_heavy.task
